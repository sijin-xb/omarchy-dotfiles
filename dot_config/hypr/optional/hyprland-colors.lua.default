hl.config({
    general = {
        col = {
            -- Note: the dynamic (lua) config setter parses a single color;
            -- multi-stop gradients are only accepted by window rules
            active_border   = "rgba(e0bcdaAA)",
            inactive_border = "rgba(1e1b1d33)",
        },
    },
    misc = {
        background_color = "rgba(151314FF)",
    },
    -- 阴影：参数对齐 Caelestia（小范围 + 柔和羽化 + 主题色），
    -- 颜色用 inverse_primary，随壁纸主题变化
    decoration = {
        shadow = {
            enabled      = true,
            range        = 15,
            render_power = 4,
            offset       = {0, 0},
            color        = "rgba(72556f1A)",
        },
    },
})

hl.window_rule({
    match        = { pin = 1 },
    border_color = "rgba(e0bcdaAA) rgba(e0bcda77)",
})
